{
  "name": "mpxhr-desktop",
  "version": "2.2.0",
  "description": "MpxHR Enterprise Desktop Solution",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "nodemon --watch src --exec electron .",
    "dist": "electron-builder",
    "postinstall": "electron-builder install-app-deps",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "Mithlesh Prasad",
  "license": "ISC",
  "type": "commonjs",
  "build": {
    "appId": "com.mpxhr.desktop",
    "productName": "MpxHR Enterprise",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png",
      "verifyUpdateCodeSignature": false,
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MpxHR Enterprise"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "database.sqlite",
        "to": "database.sqlite"
      },
      {
        "from": "docs",
        "to": "docs"
      }
    ]
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.2",
    "electron": "^39.2.7",
    "electron-builder": "^26.8.1",
    "nodemon": "^3.1.11"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "chart.js": "^4.5.1",
    "googleapis": "^171.4.0",
    "jspdf": "^3.0.4",
    "jspdf-autotable": "^5.0.2",
    "sqlite3": "^5.1.7",
    "xlsx": "^0.18.5"
  }
}
