{
  "name": "saral-clone-desktop",
  "version": "0.1.0",
  "description": "SaralPayPack clone - Desktop shell (Electron, thin client over the cloud API)",
  "main": "main.js",
  "scripts": {
    "start": "node start.js",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.saralclone.desktop",
    "productName": "MpxHR",
    "directories": { "output": "dist" },
    "files": ["main.js", "package.json"],
    "win": {
      "target": "nsis",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MpxHR"
    }
  },
  "devDependencies": {
    "electron": "^39.2.7",
    "electron-builder": "^26.8.1"
  }
}
