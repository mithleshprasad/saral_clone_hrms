PORT=4000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=saral_clone

# Set DB_SSL=true against a managed host (Aiven, PlanetScale, etc.) — they refuse a plain
# connection outright. Leave unset for local MySQL. DB_SSL_REJECT_UNAUTHORIZED=false only
# if a provider's cert chain isn't in Node's trust store (rare; prefer leaving it true).
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=8h

CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Optional — if LICENSE_KEY is left blank, this installation runs unlicensed/unrestricted
# (the normal state for local/dev work). Set it on a real client deployment to enforce that
# installation's plan (company-count cap + feature gates) against the license server.
LICENSE_KEY=
LICENSE_SERVER_URL=http://localhost:4001

# Optional — if SMTP_HOST is left blank, emails (payslip-ready, etc.) are logged to the
# email_log table instead of sent, so notifications still work end-to-end in dev/demo.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=MpxHR <no-reply@mpxhr.local>

# Optional — if SMS_API_URL is left blank, SMS notifications are logged to the sms_log
# table instead of sent. Generic JSON-POST contract ({ to, message }, bearer auth); adapt
# sms.service.js to your provider's actual API if it differs.
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=MpxHR
