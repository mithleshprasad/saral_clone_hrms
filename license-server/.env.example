PORT=4001
NODE_ENV=development

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=mpxhr_license_server

# Set DB_SSL=true against a managed host (Aiven, PlanetScale, etc.) — they refuse a plain
# connection outright. Leave unset for local MySQL.
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

JWT_SECRET=dev-license-secret-change-me
JWT_EXPIRES_IN=8h

# License Control lives inside marketing/ (5178); 5177 kept for the old standalone dev server
CORS_ORIGIN=http://localhost:5177,http://localhost:5178
